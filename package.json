{
  "name": "grizl-ugc-engine",
  "version": "1.0.0",
  "description": "GRIZL's always-on UGC scoring engine: discovers meme posts on X, validates them with perceptual-hash image matching and GPT-based text/reply quality scoring, enforces anti-farming and referral rules, and maintains a live leaderboard.",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "seed": "node scripts/seed.js",
    "discovery": "node scripts/runDiscovery.js",
    "bulk-refresh": "node scripts/runBulkRefresh.js",
    "quote-sweep": "node scripts/runQuoteSweep.js",
    "reply-sweep": "node scripts/runReplySweep.js",
    "cron": "node cron/scheduler.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "imghash": "^1.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "node-cron": "^4.2.1",
    "openai": "^6.9.1",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=18"
  }
}
