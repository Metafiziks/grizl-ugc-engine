# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_DB_NAME=grizl_ugc_demo

# --- X (Twitter) API v2 ---
# Needs a project with Recent Search + Tweet Lookup access.
TWITTER_BEARER_TOKEN=

# Query used by the daily discovery sweep to find candidate posts.
DISCOVERY_QUERY=(GRFTY OR #GRFTY) (GRIZL OR #GRIZL) (has:images OR has:media) -is:retweet -is:quote -is:reply
SHARE_HASHTAGS=(#GRIZL OR #GRFTY OR GRIZL OR GRFTY)
REPLY_HASHTAGS=(#GRIZL OR #GRFTY OR #pump OR #dump)

# --- OpenAI (post + reply quality scoring) ---
OPENAI_API_KEY=
OPENAI_SMALL_MODEL=gpt-4o-mini
FEATURE_POST_TEXT_QUALITY=true

# --- Auth ---
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:5173

# --- Scoring tuning ---
DISCOVERY_LOOKBACK_HOURS=24
BULK_REFRESH_LOOKBACK_HOURS=336
BULK_REFRESH_PAGE_LIMIT=400
REPLY_SWEEP_BATCH_USERS=200
REPLY_SWEEP_PAGES_PER_BATCH=2
IMAGE_HASH_THRESHOLD=28

# --- Server ---
PORT=3000
DEBUG_DISCOVERY=0
